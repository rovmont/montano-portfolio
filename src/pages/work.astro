---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import { sampleCategories, samplesByCategory } from "../data/samples";

const visibleCategories = sampleCategories
  .map((cat) => ({ ...cat, items: samplesByCategory(cat.id) }))
  .filter((cat) => cat.items.length > 0);
---

<BaseLayout
  title="Work"
  description="Academic, volunteer, and formal work by Rovin Niño Montaño."
>
  <div class="container">
    <header class="page-intro animate-in">
      <span class="section-label">Work</span>
      <h1>Projects and roles</h1>
      <p>A closer look at what I have built, studied, and helped run.</p>
    </header>

    <nav class="category-nav glass animate-in delay-1" aria-label="Work categories">
      {
        visibleCategories.map((cat) => (
          <a href={`#${cat.id}`}>{cat.label}</a>
        ))
      }
    </nav>

    {
      visibleCategories.map((cat, index) => (
        <section
          class:list={["category-block", "animate-in", `delay-${Math.min(index + 1, 4)}`]}
          id={cat.id}
        >
          <div class="section-header">
            <h2>{cat.label}</h2>
          </div>
          <div class="card-grid">
            {cat.items.map((sample) => (
              <WorkCard sample={sample} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.65rem;
    margin-bottom: 2.5rem;
  }

  .category-nav a {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-muted);
    transition:
      background var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }

  .category-nav a:hover {
    background: rgba(255, 255, 255, 0.7);
    color: var(--ink);
  }

  .category-block {
    margin-bottom: 3rem;
    scroll-margin-top: calc(var(--nav-height) + 5rem);
  }
</style>
