---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroIntro from "../components/HeroIntro.astro";
import ResumePreview from "../components/ResumePreview.astro";
import SectionSnippet from "../components/SectionSnippet.astro";
import WorkCard from "../components/WorkCard.astro";
import CreativeCard from "../components/CreativeCard.astro";
import YouTubeCard from "../components/YouTubeCard.astro";
// References and Recommendations snippets are on hold until there's real
// content — see the commented-out imports and SectionSnippet blocks below.
// import ReferenceCard from "../components/ReferenceCard.astro";
// import TestimonialCard from "../components/TestimonialCard.astro";
import GlassPanel from "../components/GlassPanel.astro";
import { profile } from "../data/profile";
import { samples } from "../data/samples";
import { creativePosts } from "../data/creative";
// import { references } from "../data/references";
// import { recommendations } from "../data/recommendations";
import { withBase } from "../utils/paths";

const samplePreview = samples.filter((s) => s.category === "academic").slice(0, 3);
const creativePreview = creativePosts.slice(-2).reverse();
// const referencePreview = references.slice(0, 2);
// const recommendationPreview = recommendations.slice(0, 2);
---

<BaseLayout
  title="Home"
  description={profile.tagline}
>
  <HeroIntro />

  <section class="about container animate-in">
    <GlassPanel class="about-panel">
      <span class="section-label">Introduction</span>
      <h2>Hello</h2>
      <p>{profile.bio}</p>
      <p class="meta">{profile.location} · {profile.email} · {profile.phone}</p>
    </GlassPanel>
  </section>

  <ResumePreview />

  <div class="container">
    <SectionSnippet
      label="Samples"
      title="Selected work"
      description="Academic builds with live demos: Decimal32, Profs2Pick, LabKita!, and more."
      href={withBase("/samples")}
    >
      {samplePreview.map((sample) => <WorkCard sample={sample} />)}
    </SectionSnippet>

    <SectionSnippet
      label="Creative"
      title="Writing and singing"
      description="The essays and proses I've written, and the covers I sing on my channel."
      href={withBase("/creative")}
    >
      <YouTubeCard />
      {creativePreview.map((post) => <CreativeCard post={post} />)}
    </SectionSnippet>

    {
      /*
      References and Recommendations are on hold until there's real content
      to show. Restore this markup (and the imports/consts above) once
      src/pages/_references.astro and _recommendations.astro are renamed
      back to references.astro and recommendations.astro.

      <SectionSnippet
        label="References"
        title="People who know the work"
        description="Placeholder contacts who can speak to collaboration and craft."
        href={withBase("/references")}
      >
        {referencePreview.map((reference) => <ReferenceCard reference={reference} />)}
      </SectionSnippet>

      <SectionSnippet
        label="Recommendations"
        title="Kind words"
        description="Placeholder testimonials, ready to be swapped for real quotes."
        href={withBase("/recommendations")}
      >
        {
          recommendationPreview.map((recommendation) => (
            <TestimonialCard recommendation={recommendation} />
          ))
        }
      </SectionSnippet>
      */
    }
  </div>
</BaseLayout>

<style>
  .about {
    padding: 0 0 2rem;
  }

  .about-panel {
    max-width: 40rem;
  }

  .about-panel h2 {
    font-size: 1.85rem;
    margin-bottom: 0.65rem;
  }

  .about-panel p {
    font-size: 1.05rem;
  }

  .meta {
    margin-top: 1rem;
    font-size: 0.92rem !important;
    color: var(--ink-soft) !important;
  }
</style>
