---
// NOTE: prefixed with `_` so Astro excludes this route from the build.
// Rename this file to `recommendations.astro` (and add the nav link back in
// SiteNav.astro / the snippet in index.astro) once there's real content.
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { recommendations } from "../data/recommendations";
---

<BaseLayout
  title="Recommendations"
  description="Testimonials and recommendations for Rovin Niño Montaño."
>
  <div class="container">
    <header class="page-intro animate-in">
      <span class="section-label">Recommendations</span>
      <h1>Recommendations</h1>
      <p>
        Placeholder testimonials from collaborators and mentors. Swap these for
        real quotes when you have permission to share them.
      </p>
    </header>

    <div class="card-grid animate-in delay-1">
      {
        recommendations.map((recommendation) => (
          <TestimonialCard recommendation={recommendation} />
        ))
      }
    </div>
  </div>
</BaseLayout>
