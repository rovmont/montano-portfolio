---
import { profile } from "../data/profile";
---

<section class="hero">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="section-label animate-in">Portfolio</p>
    <h1 class="animate-in delay-1">{profile.name}</h1>
    <p class="hero-tagline animate-in delay-2">{profile.tagline}</p>
    <div class="hero-actions animate-in delay-3">
      <a
        class="btn btn-primary"
        href={profile.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn Profile
      </a>
      <a class="btn btn-accent" href="#resume">Preview Resume</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 1.5rem 0 3.5rem;
    overflow: hidden;
  }

  .hero-atmosphere {
    position: absolute;
    inset: -10% -5% auto;
    height: 70%;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(143, 196, 230, 0.55), transparent 55%),
      radial-gradient(ellipse at 70% 30%, rgba(168, 201, 160, 0.4), transparent 50%),
      radial-gradient(ellipse at 55% 70%, rgba(245, 233, 184, 0.45), transparent 45%);
    filter: blur(8px);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    max-width: 28rem;
    margin-bottom: 2rem;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
