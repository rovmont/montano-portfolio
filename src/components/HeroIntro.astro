---
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";

const portraitSrc = withBase("/rovin-portrait.png");
---

<section class="hero">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="section-label animate-in">Portfolio</p>
      <h1 class="animate-in delay-1">{profile.name}</h1>
      <p class="hero-tagline animate-in delay-2">{profile.tagline}</p>
      <div class="hero-actions animate-in delay-3">
        <a
          class="btn btn-primary"
          href={profile.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn Profile
        </a>
        <a class="btn btn-accent" href="#resume">Preview Resume</a>
      </div>
    </div>

    <div class="portrait-frame animate-in delay-2">
      <img
        src={portraitSrc}
        alt="Portrait of Rovin Niño Montaño"
        width="684"
        height="1024"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 1.5rem 0 3.5rem;
    overflow: hidden;
  }

  .hero-atmosphere {
    position: absolute;
    inset: -10% -5% auto;
    height: 70%;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(143, 196, 230, 0.55), transparent 55%),
      radial-gradient(ellipse at 70% 30%, rgba(168, 201, 160, 0.4), transparent 50%),
      radial-gradient(ellipse at 55% 70%, rgba(245, 233, 184, 0.45), transparent 45%);
    filter: blur(8px);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 24rem);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6.5rem);
  }

  .hero-content {
    max-width: 40rem;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    max-width: 28rem;
    margin-bottom: 2rem;
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .portrait-frame {
    position: relative;
    width: 100%;
    max-width: 23rem;
    aspect-ratio: 4 / 5;
    justify-self: end;
    padding: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 48% 52% 46% 54% / 38% 42% 58% 62%;
    background: rgba(255, 255, 255, 0.28);
    box-shadow:
      0 24px 55px rgba(58, 122, 163, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  .portrait-frame::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 8% -8% -5% 12%;
    border-radius: 50%;
    background: linear-gradient(
      145deg,
      rgba(245, 233, 184, 0.72),
      rgba(168, 201, 160, 0.42)
    );
    filter: blur(1px);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: inherit;
  }

  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }

    .portrait-frame {
      width: min(78vw, 20rem);
      justify-self: center;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
