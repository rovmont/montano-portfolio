---
import type { Sample } from "../data/samples";
import { sampleCategories } from "../data/samples";

interface Props {
  sample: Sample;
}

const { sample } = Astro.props;
const categoryLabel =
  sampleCategories.find((c) => c.id === sample.category)?.label ?? sample.category;
---

<article class="work-card glass">
  <div class="meta">
    <span class:list={["badge", sample.category]}>{categoryLabel}</span>
    <span class="year">{sample.year}</span>
  </div>
  <h3>{sample.title}</h3>
  <p>{sample.summary}</p>
  <ul class="tags">
    {sample.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  {
    (sample.url || sample.repoUrl) && (
      <div class="links">
        {sample.url && (
          <a href={sample.url} target="_blank" rel="noopener noreferrer">
            Live demo
          </a>
        )}
        {sample.repoUrl && (
          <a href={sample.repoUrl} target="_blank" rel="noopener noreferrer">
            Repository
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .work-card {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    height: 100%;
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .work-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(58, 122, 163, 0.16), inset 0 1px 0 var(--glass-highlight);
    border-color: var(--glass-border);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(143, 196, 230, 0.4);
    color: var(--blue-600);
  }

  .badge.creative {
    background: rgba(245, 233, 184, 0.55);
    color: #8a7320;
  }

  .badge.formal {
    background: rgba(143, 196, 230, 0.35);
    color: var(--blue-600);
  }

  .badge.volunteer {
    background: rgba(168, 201, 160, 0.45);
    color: #3d6a36;
  }

  .year {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    font-size: 0.95rem;
    flex: 1;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .tags li {
    font-size: 0.78rem;
    color: var(--ink-soft);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.45);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(74, 150, 196, 0.18);
  }

  .links a {
    font-size: 0.88rem;
    font-weight: 550;
    color: var(--blue-600);
  }

  .links a:hover {
    color: var(--ink);
  }
</style>
