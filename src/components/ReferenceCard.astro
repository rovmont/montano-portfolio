---
import type { Reference } from "../data/references";

interface Props {
  reference: Reference;
}

const { reference } = Astro.props;
---

<article class="ref-card glass">
  <h3>{reference.name}</h3>
  <p class="role">{reference.role} · {reference.organization}</p>
  <p class="relationship">{reference.relationship}</p>
  <p class="note">{reference.note}</p>
  <a class="email" href={`mailto:${reference.email}`}>{reference.email}</a>
</article>

<style>
  .ref-card {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .ref-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(58, 122, 163, 0.14), inset 0 1px 0 var(--glass-highlight);
  }

  h3 {
    font-size: 1.25rem;
  }

  .role {
    font-weight: 500;
    color: var(--ink);
  }

  .relationship {
    font-size: 0.85rem;
    color: var(--blue-500);
    font-weight: 500;
  }

  .note {
    font-size: 0.95rem;
    flex: 1;
    margin-top: 0.35rem;
  }

  .email {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--blue-600);
  }

  .email:hover {
    color: var(--ink);
  }
</style>
