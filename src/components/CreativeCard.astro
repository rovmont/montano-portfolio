---
import type { CreativePost } from "../data/creative";
import { formatCreativeDate, formatCreativeYear } from "../data/creative";
import { withBase } from "../utils/paths";

interface Props {
  post: CreativePost;
}

const { post } = Astro.props;
const href = withBase(`/creative/${post.slug}`);
---

<a class="creative-card glass" href={href}>
  <div class="meta">
    <span class:list={["badge", post.kind]}>{post.kind}</span>
    <time datetime={post.date}>{formatCreativeYear(post.date)}</time>
  </div>
  <h3>{post.title}</h3>
  <p>{post.description}</p>
  <span class="read-more">
    <time datetime={post.date}>{formatCreativeDate(post.date)}</time>
    <span aria-hidden="true">Read →</span>
  </span>
</a>

<style>
  .creative-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.4rem;
    height: 100%;
    color: inherit;
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .creative-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgba(58, 122, 163, 0.16), inset 0 1px 0 var(--glass-highlight);
    border-color: var(--glass-border);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(245, 233, 184, 0.55);
    color: #8a7320;
  }

  .badge.essay {
    background: rgba(143, 196, 230, 0.4);
    color: var(--blue-600);
  }

  .badge.anthology {
    background: rgba(168, 201, 160, 0.45);
    color: #3d6a36;
  }

  time {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  h3 {
    font-size: 1.25rem;
  }

  p {
    font-size: 0.95rem;
    flex: 1;
  }

  .read-more {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(74, 150, 196, 0.18);
    font-size: 0.88rem;
    font-weight: 550;
    color: var(--blue-600);
  }
</style>
