---
import type { CreativePost } from "../data/creative";
import { withBase } from "../utils/paths";

interface Props {
  previous: CreativePost | null;
  next: CreativePost | null;
}

const { previous, next } = Astro.props;
---

<nav class="post-nav" aria-label="Post navigation">
  {
    previous ? (
      <a class="nav-item prev glass" href={withBase(`/creative/${previous.slug}`)}>
        <span class="direction">Previous</span>
        <span class="title">{previous.title}</span>
      </a>
    ) : (
      <span class="nav-item prev disabled glass" aria-disabled="true">
        <span class="direction">Previous</span>
        <span class="title">Beginning of the archive</span>
      </span>
    )
  }
  {
    next ? (
      <a class="nav-item next glass" href={withBase(`/creative/${next.slug}`)}>
        <span class="direction">Next</span>
        <span class="title">{next.title}</span>
      </a>
    ) : (
      <span class="nav-item next disabled glass" aria-disabled="true">
        <span class="direction">Next</span>
        <span class="title">End of the archive</span>
      </span>
    )
  }
</nav>

<style>
  .post-nav {
    display: grid;
    gap: 0.85rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(74, 150, 196, 0.2);
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    color: inherit;
    transition:
      transform var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  a.nav-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(58, 122, 163, 0.14), inset 0 1px 0 var(--glass-highlight);
  }

  .direction {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-500);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  .disabled {
    opacity: 0.55;
    cursor: default;
  }

  .next {
    text-align: right;
  }

  @media (min-width: 720px) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
